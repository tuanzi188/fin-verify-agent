{"id": "CX-01", "complex_type": "cross_table", "dimension": "检索与引用", "secondary_tags": ["跨表", "占比", "毛利率差"], "difficulty": "medium", "question": "美的集团 2025 年智能家居业务营业收入占公司营业收入的比重是多少？智能家居业务的毛利率比商业及工业解决方案高多少个百分点？", "tool_constraints": {}, "required_args": {}, "answer_points": [{"text": "智能家居业务 2025 年营业收入为 299,927,239 千元", "chunk_ids": ["cninfo-000333-2025-annual#t0013", "cninfo-000333-2025-annual#t0006"], "evidence": {"table_id": "cninfo-000333-2025-annual#t0013", "row": "智能家居业务", "column": 1, "value": "299,927,239"}, "unit": "千元"}, {"text": "智能家居业务毛利率为 29.90%", "chunk_ids": ["cninfo-000333-2025-annual#t0013"], "evidence": {"table_id": "cninfo-000333-2025-annual#t0013", "row": "智能家居业务", "column": 3, "value": "29.90%"}}, {"text": "商业及工业解决方案毛利率为 20.81%", "chunk_ids": ["cninfo-000333-2025-annual#t0013"], "evidence": {"table_id": "cninfo-000333-2025-annual#t0013", "row": "商业及工业解决方案", "column": 3, "value": "20.81%"}}, {"text": "公司 2025 年营业收入为 456,451,731 千元", "chunk_ids": ["cninfo-000333-2025-annual#t0006"], "evidence": {"table_id": "cninfo-000333-2025-annual#t0006", "row": "营业收入（千元）", "column": "2025 年", "value": "456,451,731"}, "unit": "千元"}, {"text": "智能家居业务占公司营业收入约 65.71%", "chunk_ids": ["cninfo-000333-2025-annual#t0013", "cninfo-000333-2025-annual#t0006"], "derived": true}, {"text": "智能家居业务毛利率比商业及工业解决方案高 9.09 个百分点", "chunk_ids": ["cninfo-000333-2025-annual#t0013"], "derived": true}], "calc": [{"formula": "a / b * 100", "inputs": {"a": 299927239, "b": 456451731}, "expected": "65.7084", "tolerance": "0.01", "note": "占比 = 分部收入 ÷ 公司营业收入 × 100；毛利率差 29.90% − 20.81% = 9.09pp 为两个披露值直接相减"}, {"formula": "a - b", "inputs": {"a": 29.9, "b": 20.81}, "expected": "9.09", "tolerance": "0.01", "note": "两个披露毛利率直接相减：29.90% − 20.81% = 9.09pp"}], "citation_required": true, "should_abstain": false, "clarify_mode": "none", "forbidden": ["把占比算成 29.90% 或 20.81%", "毛利率差说成 9.09%（应为 9.09 个百分点）"], "max_steps": 16, "relevant_chunk_ids": ["cninfo-000333-2025-annual#t0013", "cninfo-000333-2025-annual